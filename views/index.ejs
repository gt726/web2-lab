<!DOCTYPE html>
<html lang="hr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/style.css">
  <title>
    <%= title %>
  </title>
</head>

<body>

  <div class="header">

    <div>
      <h1>
        <%= title %>
      </h1>

      <p>Dobrodošli u aplikaciju za upravljanje digitalnim propusnicama.</p>
    </div>

    <div class="login-info">
      <% if (isAuthenticated) { %>
        <p>
          Prijavljeni ste kao:
          <strong>
            <%= user.name %>
          </strong>
        </p>
        <a href="/logout" class="custom-button">Odjava</a>
        <% } else { %>
          <a href="/login" class="custom-button">Prijava</a>
          <% } %>
    </div>

  </div>

  <h2>Statistika propusnica</h2>

  <p>Ukupan broj propusnica: <strong>
      <%= totalPasses %>
    </strong></p>

  <p>Broj aktivnih propusnica: <strong>
      <%= activePasses %>
    </strong></p>

  <% if (isAuthenticated) { %>

    <h2>Kreiranje propusnica</h2>

    <form action="/passes/create" method="POST">
      <div class="user-input">
        <div>
          <label for="name">Ime i prezime:</label>
          <input type="text" id="name" name="name" required />
        </div>

        <div>
          <label for="document">Broj dokumenta:</label>
          <input type="text" id="document" name="document" required />
        </div>
      </div>

      <button type="submit">Kreiraj propusnicu</button>
    </form>

    <h2>Upravljanje propusnicama</h2>
    <a href="/passes" class="custom-button">Pregledaj sve propusnice</a>

    <% } %>
</body>

</html>