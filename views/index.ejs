<!DOCTYPE html>
<html lang="hr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
</head>

<body>

  <% if (isAuthenticated) { %>
    <p>
      Prijavljeni ste kao:
      <strong>
        <%= user.name %>
      </strong>
    </p>
    <a href="/logout">Odjava</a>
    <% } else { %>
      <a href="/login">Prijava</a>
      <% } %>

        <h1>
          <%= title %>
        </h1>

        <p>Dobrodošli u aplikaciju digitalnih propusnica.</p>

        <h2>Statistika propusnica</h2>

        <p>Ukupan broj propusnica: <strong>
            <%= totalPasses %>
          </strong></p>

        <p>Broj aktivnih propusnica: <strong>
            <%= activePasses %>
          </strong></p>

        <form action="/passes/create" method="POST">
          <div>
            <label for="name">Ime i prezime:</label>
            <input type="text" id="name" name="name" required />
          </div>

          <div>
            <label for="document">Broj dokumenta:</label>
            <input type="text" id="document" name="document" required />
          </div>

          <button type="submit">Kreiraj propusnicu</button>
        </form>

        <h2>Upravljanje propusnicama</h2>
        <a href="/passes">Pregledaj sve propusnice</a>
</body>

</html>